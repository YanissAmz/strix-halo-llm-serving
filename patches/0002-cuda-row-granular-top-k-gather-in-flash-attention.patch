diff --git a/ggml/src/ggml-cuda/fattn-common.cuh b/ggml/src/ggml-cuda/fattn-common.cuh
index 4d002af32..2423b2c98 100644
--- a/ggml/src/ggml-cuda/fattn-common.cuh
+++ b/ggml/src/ggml-cuda/fattn-common.cuh
@@ -27,6 +27,9 @@ typedef void (* fattn_kernel_t)(
         const int  * __restrict__ KV_max,
         const unsigned char * __restrict__ KV_skip,
         const int    KV_skip_stride,
+        const int  * __restrict__ KV_rows,
+        const int  * __restrict__ KV_nsel,
+        const int    KV_rows_stride,
         float      * __restrict__ dst,
         float2     * __restrict__ dst_meta,
         const float scale,
@@ -796,9 +799,14 @@ static __global__ void flash_attn_mask_to_KV_skip(
 // essentially every FATTN_KQ_STRIDE tile, so tile granularity finds few fully empty tiles.
 //
 // The scan is an ordered block-wide Hillis-Steele prefix sum rather than an atomic bump: FA's
-// reduction is not order-invariant in floating point, and the correctness gate compares the sha of
-// the generated text against the dense path. An unordered list would produce a different sha on
-// every run and make that gate useless.
+// reduction is not order-invariant in floating point, so an unordered list would make the kernel
+// non-deterministic run to run, which is worse than a small numerical difference -- it makes every
+// comparison unrepeatable.
+//
+// Note that the gather is NOT bit-identical to the dense path, unlike the tile skip. Compacting the
+// rows changes which rows land in which FATTN_KQ_STRIDE tile, so the online-softmax rescaling
+// sequence changes and the low bits move. The gate is greedy token agreement at temperature 0, not
+// a sha.
 //
 // Writes count = -1 for a tile whose union exceeds cap; the kernel falls back to the dense path
 // for that tile, so cap is a memory budget, never a correctness condition.
@@ -1145,6 +1153,21 @@ static __global__ void flash_attn_combine_results(
     dst[tid] = VKQ_numerator / VKQ_denominator;
 }
 
+// Single source of truth for the row gather. The kernel is instantiated with gather = this value,
+// so the launch side and the template argument MUST be this same function: a gather instantiation
+// launched without the prepass dereferences a null row list, and a prepass whose buffers no kernel
+// reads is pure cost.
+static bool fattn_row_gather_enabled(const ggml_tensor * dst) {
+    static const char * env = getenv("DSV4_FA_ROW_GATHER");
+    if (!env) {
+        return false;
+    }
+    const ggml_tensor * Q    = dst->src[0];
+    const ggml_tensor * K    = dst->src[1];
+    const ggml_tensor * mask = dst->src[3];
+    return mask && K->ne[1] % FATTN_KQ_STRIDE == 0 && (Q->ne[1] >= 1024 || Q->ne[3] > 1);
+}
+
 template <int DV, int ncols1, int ncols2>
 void launch_fattn(
     ggml_backend_cuda_context & ctx, ggml_tensor * dst, fattn_kernel_t fattn_kernel, const int nwarps, const size_t nbytes_shared,
@@ -1186,6 +1209,9 @@ void launch_fattn(
     // bounds a CONTIGUOUS masked tail, which a scattered top-k mask never has; this skips holes.
     ggml_cuda_pool_alloc<unsigned char> KV_skip(pool);
     int KV_skip_stride = 0;
+    ggml_cuda_pool_alloc<int> KV_rows(pool);
+    ggml_cuda_pool_alloc<int> KV_nsel(pool);
+    int KV_rows_stride = 0;
     ggml_cuda_pool_alloc<float>  dst_tmp(pool);
     ggml_cuda_pool_alloc<float2> dst_tmp_meta(pool);
 
@@ -1456,6 +1482,46 @@ void launch_fattn(
     GGML_ASSERT(block_dim.x % warp_size == 0);
 
         ggml_cuda_kernel_launch_params launch_params = ggml_cuda_kernel_launch_params(blocks_num, block_dim, nbytes_shared, main_stream);
+    // DSV4_FA_ROW_GATHER: build, per Q tile, the union over that tile's queries of the KV rows the
+    // mask lets through, and have the kernel walk only those rows. The tile skip drops empty tiles
+    // and therefore decays with depth; this list is bounded by ncols1*indexer.top_k, which does not
+    // grow with n_kv. cap is rounded to FATTN_KQ_STRIDE because the prepass pads the list to a
+    // multiple of it -- the fast branch has no out-of-bounds checks and relies on that.
+    // =2 is the saboteur: truncate every list to one tile. The output MUST break; a leg that
+    // changes nothing is not a result until it is proven to execute.
+    static const char * row_gather_env = getenv("DSV4_FA_ROW_GATHER");
+    if (fattn_row_gather_enabled(KQV)) {
+        constexpr int nthreads_rows = 256;
+        const int ne_KV_max_g = ntiles_x*Q->ne[3];
+        const int cap_raw = K->ne[1];
+        KV_rows_stride = ((cap_raw + FATTN_KQ_STRIDE - 1) / FATTN_KQ_STRIDE) * FATTN_KQ_STRIDE;
+        KV_rows.alloc(size_t(ne_KV_max_g) * KV_rows_stride);
+        KV_nsel.alloc(ne_KV_max_g);
+        const dim3 blocks_rows(ntiles_x, Q->ne[3], 1);
+        ggml_cuda_kernel_launch_params lp_rows(blocks_rows, dim3(nthreads_rows, 1, 1), 0, main_stream);
+        // s31/s33 are in half2 units for the other prepasses, this kernel indexes in halves.
+        ggml_cuda_kernel_launch(flash_attn_mask_to_KV_rows<ncols1, nthreads_rows>, lp_rows,
+            (const half *) mask->data, KV_rows.ptr, KV_nsel.ptr,
+            (int) K->ne[1], KV_rows_stride, mask->nb[1] / sizeof(half), mask->nb[3] / sizeof(half));
+        CUDA_CHECK(cudaGetLastError());
+        if (row_gather_env[0] == '2') {
+            // Truncating n_sel to one tile is NOT enough to sabotage: the measured min is already
+            // 256 at low n_kv, so for many tiles the truncation is a no-op, and the rows that
+            // survive it are the lowest-indexed ones the queries actually want -- including the
+            // causal neighbourhood that dominates the softmax. The output would very likely
+            // survive, and a saboteur that cannot fail gates nothing. So zero the row list too:
+            // every query then attends to KV row 0 repeated 256 times. Row 0 is unmasked for
+            // everyone (no NaN, the kernel stays well-defined) but the answer MUST be destroyed.
+            const int one_tile = FATTN_KQ_STRIDE;
+            std::vector<int> sab(ne_KV_max_g, one_tile);
+            CUDA_CHECK(cudaMemcpyAsync(KV_nsel.ptr, sab.data(), ne_KV_max_g*sizeof(int),
+                cudaMemcpyHostToDevice, main_stream));
+            CUDA_CHECK(cudaMemsetAsync(KV_rows.ptr, 0,
+                size_t(ne_KV_max_g)*KV_rows_stride*sizeof(int), main_stream));
+            CUDA_CHECK(cudaStreamSynchronize(main_stream));
+        }
+    }
+
         ggml_cuda_kernel_launch(fattn_kernel, launch_params,
         (const char *) Q->data,
         K_data,
@@ -1464,6 +1530,7 @@ void launch_fattn(
         sinks ? ((const char *) sinks->data) : nullptr,
         KV_max.ptr,
         (const unsigned char *) KV_skip.ptr, KV_skip_stride,
+        (const int *) KV_rows.ptr, (const int *) KV_nsel.ptr, KV_rows_stride,
         !stream_k && parallel_blocks > 1 ? dst_tmp.ptr : (float *) KQV->data, dst_tmp_meta.ptr,
         scale, max_bias, m0, m1, n_head_log2, logit_softcap,
         Q->ne[0], ne01,     Q->ne[2], Q->ne[3], Q->nb[1], Q->nb[2], Q->nb[3],
