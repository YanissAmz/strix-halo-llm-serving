index 7f4cfd551..a176616af 100644
--- a/ggml/src/ggml-cuda/fattn-mma-f16.cuh
+++ b/ggml/src/ggml-cuda/fattn-mma-f16.cuh
@@ -1137,7 +1137,8 @@ static __device__ __forceinline__ void flash_attn_ext_f16_process_tile(
         const int jt,
         const int zt_gqa,
         const int kb0_start,
-        const int kb0_stop) {
+        const int kb0_stop,
+        const unsigned char * const __restrict__ KV_skip) {
 #if defined(VOLTA_MMA_AVAILABLE) || defined(TURING_MMA_AVAILABLE) || defined(AMD_WMMA_AVAILABLE) || defined(AMD_MFMA_AVAILABLE)
     //In this kernel Q, K, V are matrices while i, j, k are matrix indices.
 
@@ -1273,6 +1274,21 @@ static __device__ __forceinline__ void flash_attn_ext_f16_process_tile(
     if constexpr (ncols2 == 1) {
         constexpr bool oob_check = true;
         for (; kb0 < kb0_stop-1; ++kb0) {
+            // Fully masked KV tile: it contributes nothing to the softmax, so skip its loads and
+            // both matmuls. Tile ownership and the kb0 iteration space are unchanged, so the
+            // stream-k counter and the needs_fixup/is_fixup accounting above still hold. The last
+            // iteration is outside this loop and always runs, so KQ_max/KQ_rowsum are never empty.
+            // nstages > 1 preloads the NEXT tile from inside the iter, so a continue would
+            // desynchronise the pipeline. nstages is 0 on AMD (cp_async is NVIDIA-only).
+            if constexpr (nstages <= 1) {
+                if (KV_skip) {
+                    const int t0 = (kb0*nbatch_fa)                 / FATTN_KQ_STRIDE;
+                    const int t1 = (kb0*nbatch_fa + nbatch_fa - 1) / FATTN_KQ_STRIDE;
+                    if (KV_skip[t0] && KV_skip[t1]) {
+                        continue;
+                    }
+                }
+            }
             constexpr bool last_iter = false;
             constexpr int  k_VKQ_sup = nbatch_fa;
             flash_attn_ext_f16_iter
@@ -1293,6 +1309,21 @@ static __device__ __forceinline__ void flash_attn_ext_f16_process_tile(
     } else {
         constexpr bool oob_check = false;
         for (; kb0 < kb0_stop-1; ++kb0) {
+            // Fully masked KV tile: it contributes nothing to the softmax, so skip its loads and
+            // both matmuls. Tile ownership and the kb0 iteration space are unchanged, so the
+            // stream-k counter and the needs_fixup/is_fixup accounting above still hold. The last
+            // iteration is outside this loop and always runs, so KQ_max/KQ_rowsum are never empty.
+            // nstages > 1 preloads the NEXT tile from inside the iter, so a continue would
+            // desynchronise the pipeline. nstages is 0 on AMD (cp_async is NVIDIA-only).
+            if constexpr (nstages <= 1) {
+                if (KV_skip) {
+                    const int t0 = (kb0*nbatch_fa)                 / FATTN_KQ_STRIDE;
+                    const int t1 = (kb0*nbatch_fa + nbatch_fa - 1) / FATTN_KQ_STRIDE;
+                    if (KV_skip[t0] && KV_skip[t1]) {
+                        continue;
+                    }
+                }
+            }
             constexpr bool last_iter = false;
             constexpr int  k_VKQ_sup = nbatch_fa;
             flash_attn_ext_f16_iter
@@ -1709,6 +1740,8 @@ static __global__ void flash_attn_ext_f16(
         const char * mask_ptr,
         const char * sinks_ptr,
         const int  * KV_max_ptr,
+        const unsigned char * KV_skip_ptr,
+        const int    KV_skip_stride,
         float      * dst_ptr,
         float2     * dst_meta_ptr,
         const float scale,
@@ -1732,6 +1765,7 @@ static __global__ void flash_attn_ext_f16(
     const char * GGML_CUDA_RESTRICT mask     = mask_ptr;
     const char * GGML_CUDA_RESTRICT sinks    = sinks_ptr;
     const int  * GGML_CUDA_RESTRICT KV_max   = KV_max_ptr;
+    const unsigned char * GGML_CUDA_RESTRICT KV_skip = KV_skip_ptr;
     float      * GGML_CUDA_RESTRICT dst      = dst_ptr;
     float2     * GGML_CUDA_RESTRICT dst_meta = dst_meta_ptr;
 
@@ -1826,17 +1860,18 @@ static __global__ void flash_attn_ext_f16(
         if (KV_max) {
             kb0_stop = min(kb0_stop, KV_max[sequence*iter_j + jt] / nbatch_fa);
         }
+        const unsigned char * KV_skip_jt = KV_skip ? KV_skip + (sequence*iter_j + jt)*KV_skip_stride : nullptr;
         constexpr bool is_fixup = false; // All but (potentially) the last iterations write their data to dst rather than the fixup buffer.
         if (kb0_start == 0) {
             constexpr bool needs_fixup = false; // CUDA block is working on an entire tile.
             flash_attn_ext_f16_process_tile<DKQ, DV, ncols1, ncols2, nwarps, use_logit_softcap, V_is_K_view, needs_fixup, is_fixup>
                 (Q_f2, K_h2, V_h2, mask_h, sinks_f, dstk, dst_meta, scale, slope, logit_softcap,
-                 ne01, ne02, gqa_ratio, ne11, stride_Q1, stride_Q2, stride_K, stride_V, stride_mask, jt, zt_gqa, kb0_start, kb0_stop);
+                 ne01, ne02, gqa_ratio, ne11, stride_Q1, stride_Q2, stride_K, stride_V, stride_mask, jt, zt_gqa, kb0_start, kb0_stop, KV_skip_jt);
         } else {
             constexpr bool needs_fixup = true; // CUDA block is missing the beginning of a tile.
             flash_attn_ext_f16_process_tile<DKQ, DV, ncols1, ncols2, nwarps, use_logit_softcap, V_is_K_view, needs_fixup, is_fixup>
                 (Q_f2, K_h2, V_h2, mask_h, sinks_f, dstk, dst_meta, scale, slope, logit_softcap,
-                 ne01, ne02, gqa_ratio, ne11, stride_Q1, stride_Q2, stride_K, stride_V, stride_mask, jt, zt_gqa, kb0_start, kb0_stop);
+                 ne01, ne02, gqa_ratio, ne11, stride_Q1, stride_Q2, stride_K, stride_V, stride_mask, jt, zt_gqa, kb0_start, kb0_stop, KV_skip_jt);
         }
 
         kbc += iter_k;
@@ -1873,13 +1908,15 @@ static __global__ void flash_attn_ext_f16(
         kb0_stop = min(kb0_stop, KV_max[sequence*iter_j + jt] / nbatch_fa);
     }
 
+    const unsigned char * KV_skip_jt = KV_skip ? KV_skip + (sequence*iter_j + jt)*KV_skip_stride : nullptr;
+
     constexpr bool is_fixup = true; // Last index writes its data to fixup buffer to avoid data races with other blocks.
     constexpr bool needs_fixup = false;
